{
  "name": "@hebrah/sdk",
  "version": "0.8.2",
  "description": "Official Node.js SDK for the Hebrah healthcare connectivity platform — FHIR, HL7 v2, sandbox provisioning, and webhook delivery",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "homepage": "https://hebrah.com",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build && pnpm run test"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "hebrah",
    "healthcare",
    "fhir",
    "fhir-client",
    "hl7",
    "hl7v2",
    "ehr",
    "emr",
    "sandbox",
    "webhooks",
    "api-client",
    "medical-api",
    "healthcare-api",
    "sdk",
    "node-sdk",
    "typescript",
    "hipaa"
  ],
  "bugs": {
    "url": "https://github.com/Hebrah-inc/hebrah-sdk-node/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hebrah-inc/hebrah-sdk-node.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.0"
  }
}