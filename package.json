{
  "name": "@hebrah/sdk",
  "version": "0.9.2",
  "description": "Official Node.js SDK for the hebrah Isolated Health Environments & control plane API",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "hebrah",
    "healthcare",
    "isolated-environments",
    "fhir",
    "hl7",
    "agents",
    "mcp",
    "webhooks",
    "sdk"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hebrah-inc/hebrah-sdk-node.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.23",
      "nanoid": "^3.3.18",
      "esbuild": "^0.28.1",
      "source-map-js": "^1.2.2"
    }
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsup": "^9.0.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.0"
  }
}